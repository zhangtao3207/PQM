# 构建产物与临时文件
export/
build/
generated/
sdk_workspace/
# xsim 在仓库根异常退出时留下的产物（构建产物应落在 pl/sim/build/）
xsim.dir/
*.jou
*.log
*.str
*.pb
*.wdb
*.vcd
*.bit
*.bin

# Vivado 工程（vivado/ 下提交脚本、源码、约束、BD 源、IP 源、ip_repo 与报告）
# 注意：工程生成目录必须忽略 —— 实际目录名是 build_meas/ build_official/，
# 早先只写 vivado/build/ 是漏的，会导致 366 MB 生成物被提交。用通配覆盖所有 build*。
# XSA/bit 是可从源码重建的产物（且 *.bit 已被全局忽略），也一并排除。
vivado/build*/
vivado/*.xsa
vivado/*.bit

# BD 的生成物：BD 的源只有 .bd/.bda 与 ip/*.xci 三样，其余（ipshared 下的加密
# 网表、各 IP 的 sim_netlist/xml/dcp/veo/vho、OOC 约束）都是 Vivado 从 IP 重新
# 生成的。不忽略会带进 156 MB（单个 ipshared 网表就 14.9 MB）。
vivado/bd/**/ipshared/
vivado/bd/**/*.xml
vivado/bd/**/*.vhd
vivado/bd/**/*.vhdl
vivado/bd/**/*.v
vivado/bd/**/*.dcp
vivado/bd/**/*.veo
vivado/bd/**/*.vho
vivado/bd/**/*.xdc
vivado/bd/**/sim/
vivado/bd/**/simulation/
vivado/src/bd/**/ipshared/
vivado/src/bd/**/*.xml
vivado/src/bd/**/*.vhd
vivado/bd/**/hw_handoff/
vivado/**/ps7_init.html
vivado/src/bd/**/*.vhd
vivado/src/bd/**/*.vhdl
vivado/src/bd/**/*.v
vivado/src/bd/**/*.dcp
vivado/src/bd/**/*.veo
vivado/src/bd/**/*.vho

# IP 生成物（.xci / .coe 是源，要提交）
vivado/ip/**/sim/
vivado/ip/**/simulation/
vivado/ip/**/*.veo
vivado/ip/**/*.vho
vivado/ip/**/*.mif
vivado/ip/**/*.xml
vivado/ip/**/*.dcp
vivado/ip/**/*_stub.v
vivado/ip/**/*_stub.vhdl
vivado/ip/**/*.v
vivado/ip/**/*.vhd
vivado/ip/**/*.xdc

# 临时提交信息文件
commit_msg.txt

# ROM IP：xci/coe/.mif 与 sim/ 下的仿真网表都是仿真必需，必须提交。
# （换用真 IP 后，blk_mem_gen 模型运行时读的就是 rom_atan_lut_1024.mif；
#   仿真源在 pl/sim/models/rom_atan_lut_1024/ 下，若这里被忽略则新克隆无法仿真。）
# 只有 veo/vho/xml 这类工具生成的模板文件属于生成物，忽略。
pl/ip/rom_atan_lut_1024/*.veo
pl/ip/rom_atan_lut_1024/*.vho
pl/ip/rom_atan_lut_1024/*.xml
pl/sim/ipgen/

# 记忆/进度（DSH 插件的工具状态，不进版本控制）
.dsh/
